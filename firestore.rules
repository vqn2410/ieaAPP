rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar: verifica si el usuario está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Función auxiliar: obtiene un campo del documento del usuario en Firestore
    function getUserField(field) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data[field];
    }

    function hasUserDocument() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwnPreAssignment(userId) {
      return isAuth()
        && request.auth.token.email != null
        && userId == 'pre-' + request.auth.token.email.lower();
    }

    // Función auxiliar: verifica si el usuario tiene un rol específico
    function hasRole(role) {
      return hasUserDocument() && (
        (getUserField('role') is list && getUserField('role').hasAny([role]))
        || (getUserField('role') is string && getUserField('role') == role)
      );
    }

    function hasAnyRole(roles) {
      return hasUserDocument() && (
        (getUserField('role') is list && getUserField('role').hasAny(roles))
        || (getUserField('role') is string && roles.hasAny([getUserField('role')]))
      );
    }

    function isGlobalManager() {
      return hasAnyRole(['Admin', 'Pastor']);
    }

    function hasCampus(campusId) {
      return hasUserDocument() && campusId != null && (
        (getUserField('campusIds') is list && getUserField('campusIds').hasAny([campusId]))
        || (getUserField('campusIds') is string && getUserField('campusIds') == campusId)
      );
    }

    function canAccessCampus(campusId) {
      return isGlobalManager() || (hasRole('CampusAdmin') && hasCampus(campusId));
    }

    function managesGroup(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return isAuth() && (
        (('facilitatorUids' in group) && group.facilitatorUids is list && request.auth.uid in group.facilitatorUids)
        || (request.auth.token.email != null && ('facilitatorEmails' in group) && group.facilitatorEmails is list && group.facilitatorEmails.hasAny([request.auth.token.email.lower()]))
      );
    }

    function canManageMemberGroup(groupId) {
      return isGlobalManager()
        || (groupId != null && hasRole('CampusAdmin') && canAccessCampus(get(/databases/$(database)/documents/groups/$(groupId)).data.campusId))
        || (groupId != null && hasAnyRole(['Facilitator', 'CoFacilitator']) && managesGroup(groupId));
    }

    function isOwnMember(member) {
      return isAuth()
        && request.auth.token.email != null
        && ('email' in member.data)
        && (
          member.data.email == request.auth.token.email
          || member.data.email.lower() == request.auth.token.email.lower()
        );
    }

    function isOwnMemberId(memberId) {
      return isAuth()
        && request.auth.token.email != null
        && ('email' in get(/databases/$(database)/documents/members/$(memberId)).data)
        && get(/databases/$(database)/documents/members/$(memberId)).data.email.lower() == request.auth.token.email.lower();
    }

    // === Colección: users ===
    // Cada usuario solo puede leer su propio documento
    // Los admins pueden leer/escribir cualquier documento de usuario.
    // Un usuario nuevo puede leer únicamente su pre-asignación, identificada
    // por el email almacenado en el documento; nunca puede modificarla.
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId
        || isOwnPreAssignment(userId)
        || hasRole('Admin')
      );
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || hasRole('Admin'));
      allow delete: if isAuth() && hasRole('Admin');
    }

    match /campuses/{campusId} {
      allow read: if isAuth();
      allow create, update, delete: if isGlobalManager();
    }

    // === Colección: members ===
    // Solo usuarios autenticados pueden leer
    // Admins y pastores gestionan cualquier miembro; facilitadores solo su grupo.
    match /members/{memberId} {
      allow read: if isAuth() && (
        isOwnMember(resource)
        || canAccessCampus(resource.data.campusId)
        || (hasAnyRole(['MinistryLeader', 'AreaLeader', 'Facilitator', 'CoFacilitator', 'Maestro']) && hasCampus(resource.data.campusId))
        || (resource.data.groupId != null && managesGroup(resource.data.groupId))
      );
      allow create: if isAuth() && canManageMemberGroup(request.resource.data.groupId);
      allow update: if isAuth() && (
        (isOwnMember(resource)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'updatedAt', 'authUid'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid']) || request.resource.data.authUid == request.auth.uid))
        || canManageMemberGroup(request.resource.data.groupId)
        || (resource.data.groupId != null && canManageMemberGroup(resource.data.groupId))
      );
      allow delete: if isGlobalManager() || (hasRole('CampusAdmin') && canAccessCampus(resource.data.campusId));
    }

    // === Colección pública para miembros: birthdays ===
    // Solo contiene nombre, día, mes y campusId para celebrar cumpleaños comunitarios sin exponer datos personales sensibles.
    match /birthdays/{birthdayId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (
        hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator', 'Maestro'])
        || isGlobalManager()
      );
      allow delete: if isAuth() && (
        hasAnyRole(['Admin', 'Pastor', 'CampusAdmin'])
        || isGlobalManager()
      );
    }

    // === Colección: kids ===
    // Los roles pastorales pueden acompañar y mantener actualizada la información de niños.
    match /kids/{kidId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'Facilitator', 'CoFacilitator', 'Maestro']);
      allow delete: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    match /kidsAttendance/{attendanceId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'Facilitator', 'CoFacilitator', 'Maestro']);
      allow delete: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    // === Colección privada: asignados IBRP ===
    // Solo los encargados pastorales pueden consultar o modificar estos registros.
    match /ibrpAssigned/{assignedId} {
      allow read, write: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'AreaLeader']);
    }

    match /ibrpEvaluations/{evaluationId} {
      allow read, write: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'AreaLeader']);
    }

    // === Colección: events ===
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow update: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow delete: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    // === Colección: notifications ===
    // Son registros dirigidos: cada usuario solo puede consultar y marcar
    // como leídas sus propias notificaciones.
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
        && hasAnyRole(['Admin', 'Pastor'])
        && request.resource.data.userId is string
        && request.resource.data.userId != '';
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
      allow delete: if false;
    }

    // === Colección: visitors ===
    // Los visitantes contienen datos de contacto y solo son gestionados por
    // roles pastorales, encargados de campus y líderes de grupos.
    match /visitors/{visitorId} {
      allow read, create, update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator']);
      allow delete: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin']);
    }

    match /eventAttendance/{attendanceId} {
      allow read, create, update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator']);
      allow delete: if isGlobalManager();
    }

    match /eventRegistrations/{registrationId} {
      allow read: if isAuth() && (
        hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator'])
        || isOwnMemberId(resource.data.memberId)
      );
      allow create: if isAuth() && (
        hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator'])
        || (isOwnMemberId(request.resource.data.memberId) && request.resource.data.eventId is string)
      );
      allow update: if isAuth() && (
        hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator'])
        || (isOwnMemberId(resource.data.memberId) && request.resource.data.memberId == resource.data.memberId && request.resource.data.eventId == resource.data.eventId)
      );
      allow delete: if isGlobalManager();
    }

    match /eventVolunteers/{volunteerId} {
      allow read, create, update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator']);
      allow delete: if isGlobalManager();
    }

    match /auditLogs/{logId} {
      allow read: if isGlobalManager();
      allow create: if isAuth() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // === Colección: followups ===
    // Los seguimientos solo están disponibles para roles pastorales y de grupos.
    match /followups/{followupId} {
      allow read: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'Facilitator', 'CoFacilitator', 'CampusAdmin']);
      allow create: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'Facilitator', 'CoFacilitator', 'CampusAdmin']);
      allow update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'MinistryLeader', 'Facilitator', 'CoFacilitator', 'CampusAdmin']);
      allow delete: if isGlobalManager();
    }

    // === Colección: group_attendance ===
    match /group_attendance/{recordId} {
      allow read: if isAuth() && (
        canAccessCampus(get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.campusId)
        || managesGroup(resource.data.groupId)
      );
      allow create, update: if isAuth() && (
        (request.resource.data.groupId != null && managesGroup(request.resource.data.groupId))
        || (canAccessCampus(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.campusId) && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'Facilitator', 'CoFacilitator']))
      );
      allow delete: if isGlobalManager() || hasRole('CampusAdmin');
    }

    // === Colección: groups ===
    match /groups/{groupId} {
      allow read: if isAuth() && (
        canAccessCampus(resource.data.campusId)
        || (('facilitatorUids' in resource.data) && resource.data.facilitatorUids is list && request.auth.uid in resource.data.facilitatorUids)
        || (request.auth.token.email != null && ('facilitatorEmails' in resource.data) && resource.data.facilitatorEmails is list
          && resource.data.facilitatorEmails.hasAny([request.auth.token.email.lower()]))
      );
      allow create: if isAuth() && canAccessCampus(request.resource.data.campusId);
      allow update: if isAuth() && canAccessCampus(request.resource.data.campusId);
      allow delete: if isGlobalManager() || (hasRole('CampusAdmin') && canAccessCampus(resource.data.campusId));
    }

    // === Colección: finances ===
    match /finances/{docId} {
      allow read: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow create: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow update: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow delete: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    // === Colección: news ===
    match /news/{newsId} {
      allow read: if isAuth();
      allow create: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow update: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
      allow delete: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    // === Colección: settings ===
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAuth() && hasRole('Admin');
    }

    // === Colección: growthGroups ===
    match /growthGroups/{docId} {
      allow read: if isAuth();
      allow write: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    // === Colección: holidays ===
    match /holidays/{holidayId} {
      allow read: if isAuth();
      allow write: if isAuth() && hasRole('Admin');
    }

    // === Colección: absenceReasons ===
    match /absenceReasons/{reasonId} {
      allow read: if isAuth();
      allow write: if isAuth() && hasRole('Admin');
    }

    // === Colección: friendshipClasses ===
    match /friendshipClasses/{classId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth() && hasAnyRole(['Admin', 'Pastor']);
    }

    // === Colección: notes ===
    match /notes/{noteId} {
      allow read: if isAuth() && (resource.data.visibility == 'public' || resource.data.authorId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.authorId == request.auth.uid || hasAnyRole(['Admin', 'Pastor']));
    }

    // === Colección: groupEvaluations ===
    match /groupEvaluations/{docId} {
      allow read, create, update: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin', 'MinistryLeader', 'Facilitator', 'CoFacilitator']);
      allow delete: if isGlobalManager() || hasRole('CampusAdmin');
    }

    match /transferRequests/{requestId} {
      allow read: if isAuth() && (
        isGlobalManager() ||
        canAccessCampus(get(/databases/$(database)/documents/groups/$(resource.data.toGroupId)).data.campusId) ||
        (resource.data.fromGroupId != null && canAccessCampus(get(/databases/$(database)/documents/groups/$(resource.data.fromGroupId)).data.campusId))
      );
      allow create: if isAuth() && canAccessCampus(get(/databases/$(database)/documents/groups/$(request.resource.data.toGroupId)).data.campusId);
      allow update: if isAuth() && (
        isGlobalManager() ||
        (resource.data.fromGroupId != null && canAccessCampus(get(/databases/$(database)/documents/groups/$(resource.data.fromGroupId)).data.campusId))
      );
      allow delete: if isGlobalManager();
    }

    // === Colección: finance_member_links ===
    match /finance_member_links/{linkId} {
      allow read: if isAuth();
      allow write: if isAuth() && hasAnyRole(['Admin', 'Pastor', 'CampusAdmin']);
    }

    // === Denegar todo lo demás ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
