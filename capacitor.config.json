{
  "appId": "app.vercel.iea",
  "appName": "appiea",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#2b305b",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#2b305b",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
